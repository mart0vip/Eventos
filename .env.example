# Base de datos
# Local dev (docker compose up -d): postgresql://eventos:eventos_dev@localhost:5433/eventos
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Mercado Pago
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_PUBLIC_KEY=

# App
# Must be a publicly reachable HTTPS URL in production (Mercado Pago needs to reach
# NEXT_PUBLIC_BASE_URL/api/webhooks/mercadopago). Locally this is http://localhost:3000,
# which MP's servers cannot reach — the webhook must be tested some other way in dev
# (see docs/fase1-setup.md).
NEXT_PUBLIC_BASE_URL=https://club.example.com
ADMIN_SECRET=           # header x-admin-secret para rutas de admin

# Vercel Cron Jobs invoke /api/admin/release-expired-holds via GET with
# `Authorization: Bearer <CRON_SECRET>` — set this in production so the cron
# request is authorized (Vercel sets this automatically when the project has
# a CRON_SECRET env var; see docs/fase1-setup.md). Not needed for local dev,
# which uses `npm run dev:cron` + ADMIN_SECRET instead.
CRON_SECRET=

# Email
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=noreply@club.example.com
