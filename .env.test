# Test database on the same local Postgres started by docker-compose.yml.
# Never points at a real/dev database — tests TRUNCATE all tables between runs.
DATABASE_URL=postgresql://eventos:eventos_dev@localhost:5433/eventos_test

# Dummy values — external SDKs are mocked in tests, these just need to be
# non-empty so code that reads process.env doesn't throw during import.
MP_ACCESS_TOKEN=test-mp-access-token
MP_WEBHOOK_SECRET=test-mp-webhook-secret
MP_PUBLIC_KEY=test-mp-public-key
NEXT_PUBLIC_BASE_URL=http://localhost:3000
ADMIN_SECRET=test-admin-secret
CRON_SECRET=test-cron-secret
RESEND_API_KEY=test-resend-api-key
NOTIFICATION_FROM_EMAIL=noreply@test.local
